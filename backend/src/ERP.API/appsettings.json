{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dberpsaas;Username=postgres;Password=CHANGE_ME",
    "Redis": ""
  },
  "HealthChecks": {
    "SriProbeUrl": "",
    "SriProbeTimeoutSeconds": 5
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "ERP_"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_USE_ENV_VAR_OR_USER_SECRETS",
    "Issuer": "ZHTechnologies",
    "Audience": "ERPUsers",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/erp-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kardex": {
    "UseScalableMode":   false,
    "MaxDaysForSync":    90,
    "MaxMovimientosSync": 200000,
    "EnableAsyncReport": true,
    "UseMaterializedDailySummaries": false
  },
  "Hangfire": {
    "Enabled": false,
    "ConnectionString": "",
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "AllowLocalhost": true,
      "IpAllowlistPrefixes": [],
      "RequireGlobalSuperAdmin": true,
      "AllowAnyAuthenticatedUser": false
    }
  },
  "Deployment": {
    "SuperAdminPanelEnabled": true,
    "InitialSuperAdminSetupToken": "",
    "DedicatedSingleClientInstance": false,
    "MaxUsersPerTenant": ""
  },
  "InstallData": {
    "Enabled": false,
    "AllowDestructive": false,
    "ConfirmDestructive": ""
  },
  "PasswordReset": {
    "PublicBaseUrl": "http://localhost:5173",
    "TokenLifetimeMinutes": 60
  }
}

{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dberpsaas;Username=postgres;Password=CHANGE_ME",
    "Redis": ""
  },
  "HealthChecks": {
    "SriProbeUrl": "",
    "SriProbeTimeoutSeconds": 5
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "ERP_"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_USE_ENV_VAR_OR_USER_SECRETS",
    "Issuer": "ZHTechnologies",
    "Audience": "ERPUsers",
    "ExpirationMinutes": 60
  },
  "Auth": {
    "RefreshRotationGraceSeconds": 5,
    "RefreshRateLimitPerIpPerMinute": 60,
    "RefreshRateLimitPerUserPerMinute": 30,
    "RefreshRateLimitPerFamilyPerMinute": 20
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "SaaS": {
    "Billing": {
      "TrialGracePeriodDays": 7,
      "RenewalGracePeriodDays": 7,
      "WebhookPaymentFailureGracePeriodDays": 7,
      "TrialDurationDays": 14,
      "InvoiceDueDays": 30
    },
    "Renewal": {
      "LookAheadHours": 24
    },
    "Cache": {
      "AccessCacheL1TtlSeconds": 20,
      "AccessCacheL2TtlMinutes": 5,
      "AccessCacheVersionTtlDays": 30
    },
    "Features": {
      "EnforceOnWriteOperations": true
    },
    "Lifecycle": {
      "ReadOnlyEnforcementEnabled": true,
      "SystemActorId": "00000000-0000-0000-0000-000000000001"
    }
  },

  "ZHTechnologies": {
    "Name": "ZH Technologies",
    "TaxId": "9999999999001",
    "LegalName": "ZH Technologies S.A.S.",
    "MainAddress": "Dirección ZH Technologies",
    "Timezone": "America/Guayaquil",
    "Email": "billing@zh.technologies"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/erp-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kardex": {
    "UseScalableMode":   false,
    "MaxDaysForSync":    90,
    "MaxMovimientosSync": 200000,
    "EnableAsyncReport": true,
    "UseMaterializedDailySummaries": false
  },
  "Hangfire": {
    "Enabled": false,
    "ConnectionString": "",
    "Dashboard": {
      "Enabled": true,
      "Path": "/hangfire",
      "AllowLocalhost": true,
      "IpAllowlistPrefixes": [],
      "RequireGlobalPlatformOperator": true,
      "AllowAnyAuthenticatedUser": false
    }
  },
  "Deployment": {
    "PlatformPanelEnabled": true,
    "InitialPlatformOperatorSetupToken": "",
    "DedicatedSingleClientInstance": false,
    "MaxUsersPerSubscriber": ""
  },
  "InstallData": {
    "Enabled": false,
    "AllowDestructive": false,
    "ConfirmDestructive": ""
  },
  "PasswordReset": {
    "PublicBaseUrl": "http://localhost:5173",
    "TokenLifetimeMinutes": 60
  },
  "Snowflake": {
    "WorkerId": 1
  },
  "Subscriber": {
    "Entitlements": {
      "FailClosedWithoutActiveSubscription": true,
      "LogPlatformQueries": false
    }
  },
  "CacheDiagnostics": {
    "LogEnabled": false,
    "LogConfigSnapshot": false
  }
}

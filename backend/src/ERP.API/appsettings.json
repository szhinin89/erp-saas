{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dberpsaas;Username=postgres;Password=CHANGE_ME",
    "Redis": ""
  },
  "HealthChecks": {
    "SriProbeUrl": "",
    "SriProbeTimeoutSeconds": 5
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "ERP_"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_USE_ENV_VAR_OR_USER_SECRETS",
    "Issuer": "ZHTechnologies",
    "Audience": "ERPUsers",
    "ExpirationMinutes": 15
  },
  "Auth": {
    "RefreshRotationGraceSeconds": 5,
    "RefreshRateLimitPerIpPerMinute": 60,
    "RefreshRateLimitPerUserPerMinute": 30,
    "RefreshRateLimitPerFamilyPerMinute": 20,
    "RefreshTokenIndividualLifetimeMinutes": 43200,
    "SessionAbsoluteLifetimeMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient.sri.LogicalHandler": "Warning",
        "System.Net.Http.HttpClient.sri.ClientHandler": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/erp-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kardex": {
    "UseScalableMode": false,
    "MaxDaysForSync": 90,
    "MaxMovimientosSync": 200000,
    "EnableAsyncReport": true,
    "UseMaterializedDailySummaries": false
  },
  "SriPolling": {
    "InitialAuthorizationDelaySeconds": 5
  },
  "Hangfire": {
    "Server": {
      "Enabled": false
    },
    "Workers": {
      "core": 1,
      "communications": 2,
      "sri": 2,
      "maintenance": 1
    },
    "Jobs": {
      "process-outbox": {
        "Enabled": true,
        "Cron": "* * * * *",
        "Queue": "core",
        "BatchSize": 50
      },
      "process-communications": {
        "Enabled": true,
        "Cron": "* * * * *",
        "Queue": "communications",
        "BatchSize": 50
      },
      "reconcile-electronic-document-communications": {
        "Enabled": true,
        "Cron": "*/10 * * * *",
        "Queue": "communications",
        "BatchSize": 200
      },
      "electronic-document-retry": {
        "Enabled": true,
        "Cron": "* * * * *",
        "Queue": "sri",
        "BatchSize": 50
      },
      "sales-electronic-document-recovery": {
        "Enabled": true,
        "Cron": "* * * * *",
        "Queue": "sri",
        "BatchSize": 50
      },
      "retention-electronic-recovery": {
        "Enabled": true,
        "Cron": "* * * * *",
        "Queue": "sri",
        "BatchSize": 50
      },
      "expire-user-sessions": {
        "Enabled": true,
        "Cron": "0 4 * * *",
        "Queue": "maintenance",
        "BatchSize": 50
      }
    }
  },
  "InstallData": {
    "Enabled": false,
    "AllowDestructive": false,
    "ConfirmDestructive": ""
  },
  "PasswordReset": {
    "PublicBaseUrl": "",
    "TokenLifetimeMinutes": 60,
    "IpRequestLimit": 10,
    "IpRequestWindowMinutes": 15,
    "IdentityRequestLimit": 3,
    "IdentityRequestWindowMinutes": 60
  },
  "Snowflake": {
    "WorkerId": 1
  },
  "CacheDiagnostics": {
    "LogEnabled": false,
    "LogConfigSnapshot": false
  }
}

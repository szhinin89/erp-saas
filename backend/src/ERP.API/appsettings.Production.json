{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [ { "Name": "Console" } ]
  },
  "HealthChecks": {
    "SriProbeUrl": "https://www.sri.gob.ec/",
    "SriProbeTimeoutSeconds": 5
  }
}

@model ERP.Application.Sales.Models.FacturaTirillaModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Tirilla de Factura</title>
    <style>
        /* Tirilla tÃ©rmica: ancho segÃºn ConfiguracionFacturacion.ReceiptWidth (58 o 80 mm) */
        body {
            width: @(Model.Configuracion.ReceiptWidth + 8)mm;
            max-width: @(Model.Configuracion.ReceiptWidth + 8)mm;
            margin: 0;
            padding: 8px 4px;
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 12px;
            color: #000;
            box-sizing: border-box;
        }

        .ticket {
            width: 100%;
            max-width: @(Model.Configuracion.ReceiptWidth)mm;
        }

        .center {
            text-align: center;
        }

        .bold { font-weight: 700; }
        .small { font-size: 11px; }
        .line { border-top: 1px dashed #000; margin: 8px 0; }
        .spacer { margin-top: 12px; }

        .header img {
            max-width: 100%;
            height: auto;
            margin-bottom: 8px;
        }

        .invoice-meta,
        .customer-meta,
        .totals {
            width: 100%;
        }

        .invoice-meta td,
        .customer-meta td,
        .totals td {
            vertical-align: top;
            padding: 2px 0;
        }

        .items {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
        }

        .items th,
        .items td {
            padding: 2px 0;
        }

        .items th {
            border-bottom: 1px solid #000;
        }

        .items td.description {
            text-align: left;
        }

        .items td.quantity,
        .items td.price,
        .items td.total {
            text-align: right;
            white-space: nowrap;
        }

        .barcode {
            margin-top: 12px;
            text-align: center;
            font-size: 11px;
            letter-spacing: 1px;
        }

        @@media print {
            body { margin: 0; padding: 0; }
            .ticket { page-break-inside: avoid; }
        }
    </style>
</head>
<body>
    <section class="ticket">
        <div class="header center">
            @if (!string.IsNullOrWhiteSpace(Model.Configuracion.LogoBase64))
            {
                <img src="data:image/png;base64,@Model.Configuracion.LogoBase64" alt="Logo" />
            }
            <div class="bold">@Model.Configuracion.TradeName</div>
            <div class="small">@Model.Configuracion.LegalName</div>
            <div class="small">RUC: @Model.Configuracion.Ruc</div>
            <div class="small">@Model.Configuracion.MainAddress</div>
            <div class="small">Tel: @Model.Configuracion.Phone</div>
            @if (!string.IsNullOrWhiteSpace(Model.Configuracion.Email))
            {
                <div class="small">@Model.Configuracion.Email</div>
            }
        </div>

        <div class="line"></div>

        <table class="invoice-meta small">
            <tr>
                <td>Factura:</td>
                <td class="bold">@Model.Venta.DocType-@Model.Venta.EstabCode-@Model.Venta.EmPointCode-@Model.Venta.Sequential</td>
            </tr>
            <tr>
                <td>Fecha:</td>
                <td>@Model.Venta.IssueDate.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
            <tr>
                <td>Estado:</td>
                <td>@Model.Venta.Status</td>
            </tr>
            @if (!string.IsNullOrWhiteSpace(Model.Venta.AuthNumber))
            {
                <tr>
                    <td>AutorizaciÃ³n:</td>
                    <td>@Model.Venta.AuthNumber</td>
                </tr>
            }
        </table>

        <div class="line"></div>

        <table class="customer-meta small">
            <tr>
                <td>Cliente:</td>
                <td class="bold">@(Model.Buyer?.TradeName ?? Model.Buyer?.LegalName ?? "CONSUMIDOR FINAL")</td>
            </tr>
            <tr>
                <td>Identificación:</td>
                <td>@(Model.Buyer?.Identification.Type ?? "") @(Model.Buyer?.Identification.Number ?? "9999999999")</td>
            </tr>
        </table>

        <div class="line"></div>

        <table class="items small">
            <thead>
                <tr>
                    <th class="description">DescripciÃ³n</th>
                    <th class="quantity">Qty</th>
                    <th class="price">P.U.</th>
                    <th class="total">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.Venta.Lines)
                {
                    <tr>
                        <td class="description">@detalle.Description</td>
                        <td class="quantity">@detalle.Quantity</td>
                        <td class="price">@detalle.UnitPrice.ToString("N2")</td>
                        <td class="total">@detalle.Total.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="line"></div>

        <table class="totals small">
            <tr>
                <td>Subtotal</td>
                <td class="total">@Model.Venta.Subtotal.ToString("N2")</td>
            </tr>
            <tr>
                <td>Impuesto</td>
                <td class="total">@Model.Venta.TaxTotal.ToString("N2")</td>
            </tr>
            <tr class="bold">
                <td>Total</td>
                <td class="total">@Model.Venta.Total.ToString("N2")</td>
            </tr>
        </table>

        <div class="line"></div>

        @if (!string.IsNullOrWhiteSpace(Model.Configuracion.FooterText))
        {
            <div class="small center">@Model.Configuracion.FooterText</div>
        }

        @if (Model.EsPrueba)
        {
            <div class="small center bold spacer">FACTURA DE PRUEBA</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Venta.AccessKey))
        {
            <div class="barcode">@Model.Venta.AccessKey</div>
        }
    </section>
</body>
</html>



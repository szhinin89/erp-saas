# Copiar a `.env` en la raíz del repo (NO versionado — ver .gitignore) para tener
# valores por defecto al correr `docker compose up -d` / `docker-compose.dev.yml`
# sin exportar variables manualmente. Docker Compose carga `.env` automáticamente
# si existe en el directorio donde se invoca el comando.
#
# Esto es SOLO para desarrollo local. No lo uses para localprod (usa
# .env.docker.local, ver .env.docker.local.example) ni para producción real
# (docker-compose.prod.yml exige POSTGRES_PASSWORD real vía entorno/secret store,
# sin ningún default — falla el arranque si falta).

POSTGRES_PASSWORD=changeme-local

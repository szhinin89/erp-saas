{
  "AllowedHosts": "127.0.0.1;localhost",
  "PrintAgent": {
    "BindHost": "127.0.0.1",
    "Port": 9817,
    "AllowLan": false,
    "ApiKey": "replace-with-cash-register-local-secret",
    "MaxPayloadBytes": 65536,
    "DataDirectory": "C:\\ProgramData\\ZH Technologies\\PrintAgent",
    "PollIntervalMilliseconds": 500,
    "MaxAttempts": 5,
    "BaseRetryDelaySeconds": 5,
    "ProcessingStaleAfterSeconds": 300,
    "AllowedCorsOrigins": [
      "http://127.0.0.1:5173",
      "http://localhost:5173"
    ],
    "FailingPrinters": [],
    "Printers": [
      {
        "Name": "POS-80",
        "Driver": "windows-raw",
        "Enabled": true,
        "IsDefault": true
      }
    ]
  }
}

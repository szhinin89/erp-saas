{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "127.0.0.1;localhost",
  "PrintAgent": {
    "BindHost": "127.0.0.1",
    "Port": 9817,
    "AllowLan": false,
    "ApiKey": "local-dev-key-change-me",
    "MaxPayloadBytes": 65536,
    "DataDirectory": "data",
    "PollIntervalMilliseconds": 500,
    "MaxAttempts": 3,
    "BaseRetryDelaySeconds": 5,
    "ProcessingStaleAfterSeconds": 300,
    "AllowedCorsOrigins": [
      "http://127.0.0.1:5173",
      "http://localhost:5173"
    ],
    "FailingPrinters": [],
    "Printers": [
      {
        "Name": "POS-80",
        "Driver": "simulated",
        "Enabled": true,
        "IsDefault": true
      },
      {
        "Name": "FAIL-POS-80",
        "Driver": "simulated",
        "Enabled": true,
        "IsDefault": false
      }
    ]
  }
}

# Copiar a .env.development (no versionado). Vacío = /api vía proxy de Vite.
# VITE_API_URL=

# ZH Print Agent local por caja.
# Base local por defecto: http://127.0.0.1:9817
# No guardar claves reales en el repositorio. Para piloto, definir la API key
# en .env.development local o en localStorage: zh.printAgent.apiKey.
# VITE_PRINT_AGENT_BASE_URL=http://127.0.0.1:9817
# VITE_PRINT_AGENT_RECEIPT_ENDPOINT=/print-jobs
# VITE_PRINT_AGENT_API_KEY=
# VITE_PRINT_AGENT_PRINTER_NAME=POS-80

# Plantilla del stack de aplicación (docker-compose.app.yml). Copiar a .env.app (ignorado por Git).
# Nunca versionar secretos reales. Operar con scripts/app-stack.ps1 (valida este archivo).
#
# Base de datos — sin valor por defecto en Compose; siempre explícita:
#   ensayo local: erp_zh_test   ·   producción: erp_zh_prod (solo en su host)
#   erp_zh_dev es exclusiva de `dotnet run`/dev-launcher: app-stack.ps1 la rechaza.
# POSTGRES_DB y la base de Hangfire__StorageConnectionString deben coincidir.
ERP_IMAGE=erp-saas:local
FRONTEND_IMAGE=erp-frontend:local
ERP_NETWORK=erp-saas_default
POSTGRES_HOST=postgreszh
POSTGRES_DB=erp_zh_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# Conexión explícita completa; DNS interno, puerto 5432; nunca localhost/5435.
Hangfire__StorageConnectionString=Host=postgreszh;Port=5432;Database=erp_zh_test;Username=postgres;Password=CHANGE_ME
Redis__ConnectionString=erp-saas-redis:6379,abortConnect=false
# Prefijo propio por base: el Redis local es compartido con desarrollo (producción: ERP_).
Redis__InstanceName=ERP_TEST_
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET
# Hosts local: 127.0.0.1 erp.local.test; en producción, URLs HTTPS reales.
PUBLIC_FRONTEND_URL=http://erp.local.test:8080
PUBLIC_API_URL=http://localhost:5003
API_PORT=5003
FRONTEND_PORT=8080
# SMTP opcional compartido por API/Worker; la configuración por empresa tiene precedencia.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=
SMTP_USE_SSL=true

# --- SEC-A01: exposición y límites de login (ver docs/deployment/README.md) ---
# Hosts permitidos (separados por ;), sin comodín. Producción: el dominio real, p. ej. erp.ejemplo.com.
ALLOWED_HOSTS=erp.local.test;localhost
# true si hay más de una instancia de API.
REDIS_REQUIRED=false
# Proxy confiable (IP) o red (CIDR) verificados del proxy inverso. Vacío = no se procesan
# X-Forwarded-For/-Proto. Nunca declarar un rango amplio sin verificar quién puede alcanzar la API.
FORWARDED_KNOWN_PROXY=
FORWARDED_KNOWN_NETWORK=
# Límites de login (valores aprobados). K2 (IP) = 0 hasta verificar la IP real tras el proxy.
LOGIN_THROTTLE_WINDOW_MINUTES=15
LOGIN_THROTTLE_ACCOUNT_IP_LIMIT=5
LOGIN_THROTTLE_IP_LIMIT=0
LOGIN_THROTTLE_ACCOUNT_LIMIT=30
# Vacío = valores por defecto del código (procesadores / 4x concurrencia); fijar tras medir BCrypt.
LOGIN_THROTTLE_MAX_CONCURRENT=
LOGIN_THROTTLE_QUEUE_LIMIT=
LOGIN_THROTTLE_MAX_QUEUE_WAIT_MS=2000

# Copy to .env.docker.local (gitignored). Never commit real secrets.
# Canonical app deployment: PostgreSQL/Redis already exist in ERP_NETWORK.
ERP_IMAGE=erp-saas:phase-d-local
FRONTEND_IMAGE=erp-frontend:phase-d-local
ERP_NETWORK=erp-saas_default
POSTGRES_HOST=postgreszh
POSTGRES_DB=dberpsaas
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
# Explicit full connection; DNS internal, port 5432; never localhost/5435.
Hangfire__StorageConnectionString=Host=postgreszh;Port=5432;Database=dberpsaas;Username=postgres;Password=CHANGE_ME
Redis__ConnectionString=erp-saas-redis:6379,abortConnect=false
Redis__InstanceName=ERP_
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET
# Local hosts entry: 127.0.0.1 erp.local.test; replace with real HTTPS URLs in prod.
PUBLIC_FRONTEND_URL=http://erp.local.test:8080
PUBLIC_API_URL=http://localhost:5003
API_PORT=5003
FRONTEND_PORT=8080
# Optional SMTP fallback shared by API/Worker; company settings retain precedence.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=
SMTP_USE_SSL=true

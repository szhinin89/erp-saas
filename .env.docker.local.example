# Copiar a .env.docker.local (NO versionado — ver .gitignore) y completar valores reales.
# Usado por: docker compose -f docker-compose.localprod.yml --env-file .env.docker.local up -d --build
#
# Este archivo NO crea PostgreSQL ni Redis nuevos: apunta a los contenedores YA EXISTENTES
# (postgreszh, erp-saas-redis). Ver docs/DOCKER_LOCAL_PROD.md para cómo confirmar estos
# nombres/puertos en tu máquina antes de levantar el stack.
#
# Seguridad: POSTGRES_PASSWORD y JWT_SECRET_KEY son secretos — rótalos si se exponen
# (p.ej. impresos por error en un log o terminal compartida) y NUNCA los pegues en
# `docker compose config` sin redactar la salida. Ver docs/DOCKER_LOCAL_PROD.md § Seguridad.

# --- Entorno ASP.NET Core (nunca Development en este compose) ---
ASPNETCORE_ENVIRONMENT=Production

# --- PostgreSQL existente (contenedor postgreszh) ---
# Host: nombre del contenedor Postgres existente, tal como aparece en `docker ps`
#       y visible en la red erp-saas_default (`docker network inspect erp-saas_default`).
POSTGRES_HOST=postgreszh
POSTGRES_PORT=5432
POSTGRES_DB=dberpsaas
POSTGRES_USER=postgres
# Debe coincidir EXACTAMENTE con la contraseña real del Postgres ya corriendo.
POSTGRES_PASSWORD=CHANGE_ME_USE_REAL_PASSWORD

# --- Redis existente (contenedor erp-saas-redis) ---
REDIS_HOST=erp-saas-redis
REDIS_PORT=6379

# --- Seguridad ---
# Generar uno propio, no reutilizar el de Development. Ejemplo:
#   openssl rand -base64 48
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET

# --- Puertos publicados en el host ---
API_PORT=5003
FRONTEND_PORT=8080

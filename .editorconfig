root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,sln,slnx}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

# EF Core migrations are auto-generated — suppress analyzers
[**/Migrations/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# Test files: underscore naming is xUnit/NUnit convention — suppress CA1707 only
[**.Tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1001.severity = none
